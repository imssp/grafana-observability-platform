{
  "uid": "demo-overview",
  "title": "Demo API - Observability as Code",
  "tags": [
    "terraform",
    "observability-as-code",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-demo"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_http_requests_total[1m]))",
          "legendFormat": "Requests per second"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Error percentage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-demo"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(demo_http_requests_total{status=\"500\"}[1m])) / clamp_min(sum(rate(demo_http_requests_total[1m])), 0.001)",
          "legendFormat": "Error percentage"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "P95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-demo"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(demo_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95 latency"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Requests by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-demo"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(demo_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Application logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-demo"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"demo\"} | json",
          "legendFormat": "Application logs"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true
      }
    }
  ]
}
